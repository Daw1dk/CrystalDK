        Title = "Click Me",
        Callback = function()
            print("Button pressed")
        end,
    })

    Main:CreateToggle({
        Title = "Toggle",
        Default = false,
        Callback = function(state)
            print(state)
        end,
    })

    Main:CreateSlider({
        Title = "Slider",
        Min = 0,
        Max = 100,
        Default = 50,
        Callback = function(value)
            print(value)
        end,
    })

]]

