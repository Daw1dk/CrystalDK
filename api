CrystalDK V2.5.0 API

Quick Start

```lua
local CrystalDK = loadstring(game:HttpGet("https://raw.githubusercontent.com/Daw1dk/CrystalDK/refs/heads/main/lua"))()

local Window = CrystalDK:CreateWindow({
    Name = "CrystalDK Core",
    LoadingTitle = "CrystalDK Core",
    LoadingSubtitle = "State + persistence demo",
    KeySystem = false,
    SettingsEnabled = true,
    ShowSystemSettings = false,
    ToggleUIKey = Enum.KeyCode.Y,
    MinimizeKey = Enum.KeyCode.T,
    ThemeCycleKey = Enum.KeyCode.L,
    DefaultProfile = "default",
    PersistenceFolder = "CrystalDK",
})

local Main = Window:Tab("Main")

Window:CreateState("density", 0.65, {Persist = true})

Main:CreateSlider({
    Id = "density_slider",
    Title = "Density",
    Subtitle = "step size now supports decimals",
    Min = 0,
    Max = 1,
    Step = 0.05,
    State = {
        Name = "density",
        Persist = true,
    },
    Persist = true,
})

Main:CreateButton({
    Id = "save_profile",
    Title = "Save Configuration",
    Subtitle = "writes the active profile",
    Callback = function()
        Window:SaveConfiguration()
    end,
})
```

