TargetPage:CreateButton({
    Id = "demo_store_place",
    Title = "Store Current Target",
    Subtitle = "pushes the current Vector3 into saved data and refreshes the repeater",
    Callback = function()
        local position = targetVector:Get()
        table.insert(savedPlaces, {
            Name = "Point " .. tostring(#savedPlaces + 1),
            Position = position,
            Note = "Stored from Vector3 input",
        })
        savePlaces()
        if savedRepeater then
            savedRepeater:SetItems(savedPlaces)
        end
        Window:SetState("demo_live_notes", "Saved point count: " .. tostring(#savedPlaces))
        setStatus("Stored target point")
    end,
})

savedRepeater = SavedPage:CreateRepeater({
    Id = "demo_saved_repeater",
    Title = "Saved Places",
    Subtitle = "repeater owns its runtime cards",
    Items = savedPlaces,
    EmptyText = "No saved places yet.",
    Layout = "cards",
    RenderItem = function(scope, item, index)
        scope:CreateButton({
            Id = "demo_saved_place_" .. index,
            Title = item.Name,
            Subtitle = string.format("%.1f, %.1f, %.1f", item.Position.X, item.Position.Y, item.Position.Z),
            Callback = function()
                targetVector:Set(item.Position)
                setStatus("Loaded " .. tostring(item.Name))
            end,
            ContextActions = {
                {
                    Label = "Delete",
                    Callback = function()
                        table.remove(savedPlaces, index)
                        savePlaces()
                        savedRepeater:SetItems(savedPlaces)
                        setStatus("Deleted " .. tostring(item.Name))
                    end,
                },
            },
        })

        scope:CreateInlineStatus({
            Id = "demo_saved_place_note_" .. index,
            Title = "Note",
            Value = item.Note or "No note",
        })
    end,
})

