local Window = CrystalDK:CreateWindow({
    Name = "CrystalDK by Daw1dk",
    LoadingTitle = "CrystalDK",
    LoadingSubtitle = "Small Feature Demo",
    KeySystem = true,

    KeySettings = {
        Title    = "Key Required",
        Subtitle = "Enter your access key",
        Note     = "Join the Discord to obtain a valid key",
        Keys     = { "Daw1dk", "FlaviusMaverick", "B4Eekker" },
    },
})

-- KeySystem can be off, in which case settings are not needed
-- To reference SessionID use "Session_ID"
-- To reference UserScriptID use "User_Script_ID"

local MovementTab = Window:CreateTab("Movement")
local CameraTab   = Window:CreateTab("Camera")
local TeleportTab = Window:CreateTab("Teleport")

-- Creates tabs,  needs to be above all logic

MovementTab:CreateDivider({ Label = "Character Movement" })

MovementTab:CreateSlider({
    Title = "WalkSpeed",
    Subtitle = "Default = 16",
    Min = 0,
    Max = 200,
    Default = 16,
    Callback = function(v)
        local hum = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = v end
    end,
})

MovementTab:CreateStepper({
    Title = "JumpPower",
    Subtitle = "Default = 50",
    Min = 0,
    Max = 300,
    Default = 50,
    Increment = 5,
    Callback = function(v)
        local hum = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then hum.JumpPower = v end
    end,
})

CameraTab:CreateDivider({ Label = "Camera Settings" })

CameraTab:CreateSlider({
    Title = "Field of View",
    Subtitle = "Default = 70",
    Min = 30,
    Max = 120,
    Default = 70,
    Callback = function(v)
        workspace.CurrentCamera.FieldOfView = v
    end,
})

TeleportTab:CreateDivider({ Label = "Teleport Options" })

local playerList = {}
for _, plr in ipairs(game.Players:GetPlayers()) do
    table.insert(playerList, plr.Name)
end

local selectedPlayer = nil

TeleportTab:CreateDropdown({
    Title = "Player to Teleport To",
    Subtitle = "Select a player",
    Options = playerList,
    Default = playerList[1],
    Callback = function(name)
        selectedPlayer = name
    end,
})

TeleportTab:CreateButton({
    Title = "Teleport to Player",
    Subtitle = "Uses dropdown selection",
    RequireConfirmation = false,
    RequireCooldown = true,
    CooldownDuration = 2,
    Callback = function()
        local target = game.Players:FindFirstChild(selectedPlayer)
        local char = game.Players.LocalPlayer.Character
        if target and target.Character and char then
            char:PivotTo(target.Character:GetPivot())
        end
    end,
})

TeleportTab:CreateButton({
    Title = "Teleport to Random Player",
    Subtitle = "Excludes yourself",
    RequireConfirmation = false,
    RequireCooldown = true,
    CooldownDuration = 3,
    Callback = function()
        local players = {}
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr ~= game.Players.LocalPlayer then
                table.insert(players, plr)
            end
        end

        if #players > 0 then
            local randomPlr = players[math.random(1, #players)]
            local char = game.Players.LocalPlayer.Character
            if randomPlr.Character and char then
                char:PivotTo(randomPlr.Character:GetPivot())
            end
        end
    end,
})

print("Session ID: " .. Session_ID)
print("User ID: " .. User_Script_ID)

