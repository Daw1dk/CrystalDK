                local ping = "n/a"
                pcall(function()
                    local item = Stats.Network.ServerStatsItem["Data Ping"]
                    if item then
                        ping = tostring(item.GetValue and item:GetValue() or item:GetValueString())
                    end
                end)
                obj:SetRows({
                    { System = "Blur",       Value = tostring(math.floor((tonumber(Window:GetState("demo_render_blur"))        or 22) + 0.5)) },
                    { System = "FOV",        Value = tostring(math.floor((tonumber(Window:GetState("demo_render_fov"))         or 35) + 0.5)) },
