    Title = "SectionRules",
    Content = "This entire section is controlled once at the container level instead of copying the same rule to every child card.",
})

local visibilityGroup = RulesTab:CreateCollapsibleGroup({
    Id = "demo_visibility_rules_group",
    Title = "VisibilityRules Group",
    Color = Color3.fromRGB(110, 198, 255),
    VisibilityRules = {
        State = "demo_rule_mode",
        In = {"Target", "Saved"},
    },
})

visibilityGroup:CreateInlineStatus({
    Id = "demo_visibility_group_status",
    Title = "VisibilityRules",
    Value = "Mode is Target or Saved",
})

visibilityGroup:CreateButton({
    Id = "demo_visibility_group_jump",
    Title = "Jump To Target Position",
    Subtitle = "uses a grouped action surface",
    Hint = "This card also shows the delayed hover hint rule.",
    Callback = function()
        Window:BringToCard({Tab = "Build", Id = "demo_target_vector"})
        setStatus("Jumped from VisibilityRules group")
    end,
})

local groupRuleDemo = RulesTab:CreateAdvancedGroup({
    Id = "demo_group_rules_advanced",
    Title = "GroupRules Builder",
    Description = "This advanced group uses a single GroupRules definition for all children.",
    GroupRules = {
        State = "demo_rule_mode",
        NotEquals = "Disabled",
    },
})

groupRuleDemo:CreateInlineStatus({
    Id = "demo_group_rules_status",
    Title = "GroupRules",
    Value = "Hidden only when mode becomes Disabled",
})

groupRuleDemo:CreateButton({
    Id = "demo_group_rules_button",
    Title = "Snapshot Rule Trace",
    Subtitle = "state-driven groups can still host ordinary action cards",
    Callback = function()
        local trace = Window:GetRuleTrace("demo_rule_equals")
        Window:SetState("demo_modal_note", "Rule trace entries: " .. tostring(#trace))
        setStatus("Rule trace captured")
    end,
})

Catalog:CreateParagraph({
    Id = "demo_catalog_intro",
    Title = "Card Atlas",
    Content = "This tab gathers the common card families into a compact atlas. Pair it with the Rules and Activity tabs to see inputs, actions, persistence, layout, and modal helpers working together.",
})

Catalog:CreateInput({
    Id = "demo_catalog_name_input",
    Title = "Atlas Name",
    Subtitle = "single-line card with shared persistence",
    Default = Window:GetState("demo_catalog_input"),
    State = {Name = "demo_catalog_input", Persist = true},
    Persist = true,
    MaxLength = 24,
})

Catalog:CreateMultilineInput({
    Id = "demo_catalog_multiline",
    Title = "Atlas Notes",
    Subtitle = "multiline helper card with explicit length limits",
    Default = "Buttons act. Inputs persist. Rules decide when surfaces appear.",
    Lines = 4,
    MaxLength = 180,
})

Catalog:CreateCodeInput({
    Id = "demo_catalog_code",
    Title = "Atlas Code",
    Subtitle = "code styling stays additive on top of multiline input",
    Default = "return {\n    mode = 'demo',\n    enabled = true,\n}",
    Lines = 5,
    MaxLength = 220,
})

Catalog:CreateRepeater({
    Id = "demo_catalog_repeater",
    Title = "Feature Families",
    Subtitle = "runtime-owned card rows rendered by a repeater",
    Layout = "rows",
    Items = {
        {Name = "Layout", Description = "Sections, groups, subtabs, and repeaters"},
        {Name = "Inputs", Description = "Text, code, dropdown, keybind, color, vector"},
        {Name = "Actions", Description = "Buttons, modals, context actions, notifications"},
        {Name = "Data", Description = "Configuration persistence plus SaveData helpers"},
    },
    RenderItem = function(scope, item, index)
        scope:CreateLabel({
            Id = "demo_catalog_family_" .. index,
            Title = item.Name,
            Subtitle = item.Description,
            Value = tostring(index),
        })
    end,
})

Window:SetTheme(Window:GetState("demo_theme_mode") or "Aurora")

if savedRepeater then
    savedRepeater:SetItems(savedPlaces)
end

if stepList then
    stepList:SetItems(orderedSteps)
end

