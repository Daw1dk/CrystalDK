Overview:CreateLineGraph({
    Id = "demo_runtime_graph",
    Title = "Live Pulse Graph",
    Subtitle = "self-updating through RequireUpdate",
    Points = {18, 31, 44, 38, 57, 62, 54},
    RuleGroup = "flash_gold",
    Rules = {
        RequireUpdate = function(state, obj)
            state._tick = state._tick or 0
            state._points = state._points or {18, 31, 44, 38, 57, 62, 54}
            if os.clock() - state._tick >= 0.9 then
                state._tick = os.clock()
                table.insert(state._points, math.random(20, 98))
                while #state._points > 14 do
                    table.remove(state._points, 1)
                end
                obj:SetPoints(state._points)
            end
        end,
    },
})

Overview:CreateTable({
    Id = "demo_runtime_table",
    Title = "Runtime Snapshot",
    Subtitle = "telemetry driven by card-local update logic",
    Columns = {"Metric", "Value"},
    Rows = {},
    RuleGroup = "flash_blue_hover",
    Rules = {
        RequireUpdate = function(state, obj)
            state._tick = state._tick or 0
            if os.clock() - state._tick >= 0.4 then
                state._tick = os.clock()
                local ping = nil
                pcall(function()
                    local item = Stats.Network.ServerStatsItem["Data Ping"]
                    if item and item.GetValue then
                        ping = tonumber(item:GetValue())
                    elseif item and item.GetValueString then
                        ping = tonumber(tostring(item:GetValueString()):match("([%d%.])"))
                    end
                end)
                obj:SetRows({
                    {Metric = "Permission", Value = tostring(Window:GetPermissionLevel())},
                    {Metric = "Theme", Value = tostring(Window:GetTheme())},
                    {Metric = "Key Source", Value = tostring(Window:GetKeySource())},
                    {Metric = "Bound Mirror", Value = tostring(Window:GetValue("demo_trimmed_mirror_target") or "none")},
                })
            end
        end,
    },
})

