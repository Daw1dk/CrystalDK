local function getHumanoid()
    local character = getCharacter()
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function readPingMs()
    local ok, result = pcall(function()
        local item = Stats.Network.ServerStatsItem["Data Ping"]
        if item and item.GetValue then
            return tonumber(item:GetValue())
        end
        if item and item.GetValueString then
            local valueString = tostring(item:GetValueString())
            local ms = valueString:match("([%d%.]+)")
            return tonumber(ms)
        end
        return nil
    end)
    if ok then
        return result
    end
    return nil
end

local function averageValues(values)
    local total = 0
    local count = 0
    for _, value in ipairs(values or {}) do
        total += tonumber(value) or 0
        count += 1
    end
    return count > 0 and (total / count) or 0
end

