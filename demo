local runtimeCluster
local serviceTable
local stateEventCount = 0

local function setRuntime(status, percent, point)
    local nextPercent = math.clamp(tonumber(percent) or 0, 0, 100)
    Window:BatchStateUpdates({
        demo_runtime_status = status,
        demo_runtime_percent = nextPercent,
        demo_last_event = status,
    })
    if runtimeCluster then
        runtimeCluster:SetStatus(status, nextPercent)
        runtimeCluster:AddPoint(point or nextPercent)
    end
end

local function buildServiceRows()
    return {
        {Service = "Sections", State = "Grouped", Owner = "Compose", Load = 91},
        {Service = "State Watchers", State = tostring(stateEventCount) .. " events", Owner = "Overview", Load = 78},
        {Service = "Prompt / Select", State = "Ready", Owner = "Compose", Load = 73},
        {Service = "Profiles", State = Window:GetConfigurationProfile(), Owner = "Profiles", Load = 84},
        {Service = "Rule Trace", State = "Inspectable", Owner = "Data", Load = 66},
        {Service = "Action Center", State = "Live", Owner = "Activity", Load = 88},
    }
end

Window:SubscribeState("*", function(_, _, stateName)
    stateEventCount += 1
    if stateName ~= "demo_last_event" then
        Window:SetState("demo_last_event", "State changed: " .. tostring(stateName))
    end
    if serviceTable then
        serviceTable:SetRows(buildServiceRows())
    end
end)

