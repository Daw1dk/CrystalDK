local function setRuntime(status, percent, point)
    local p = math.clamp(tonumber(percent) or 0, 0, 100)
    Window:SetState("demo_runtime_status",  status)
    Window:SetState("demo_runtime_percent", p)
    runtimeCluster:SetStatus(status, p)
    runtimeCluster:AddPoint(point or p)
end

local function buildServiceRows()
    return {
        { Service = "Status Cluster", State = Window:GetState("demo_runtime_status"),  Owner = "Overview",     Load = Window:GetState("demo_runtime_percent") },
        { Service = "Shared State",   State = "Bound",                                  Owner = "State+Theme",  Load = math.floor((tonumber(Window:GetState("demo_density")) or 0) * 100 + 0.5) },
