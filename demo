 Load CrystalDK

 CrystalDK:CreateWindow({
     Name = "string",
     LoadingTitle = "string",
     LoadingSubtitle = "string",

     KeySystem = true/false,
     KeySettings = {
         Title = "string",
         Subtitle = "string",
         Note = "string",
         Keys = { "Key1", "Key2", ... },
