local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoid()
    local character = getCharacter()
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getBloomEffect()
    return Lighting:FindFirstChildOfClass("BloomEffect")
end

local function notify(title, subtitle, duration)
    if Window then
        Window:SendNotification({
            Title = title,
            Subtitle = subtitle,
            Duration = duration or 2,
        })
    end
end

local function setCardValue(card, value)
    if card and type(card.Set) == "function" then
        card:Set(value)
    elseif card and type(card.SetValue) == "function" then
        card:SetValue(value)
    end
end

local function setStatus(card, status, percent)
    if card and type(card.SetStatus) == "function" then
        card:SetStatus(status, percent)
    elseif card and type(card.Set) == "function" then
        local text = percent ~= nil and (tostring(status) .. " " .. tostring(percent) .. "%") or tostring(status)
        card:Set(text)
    end
end

local function setPlayerWalkSpeed(value)
    local humanoid = getHumanoid()
    if humanoid then
        humanoid.WalkSpeed = value
    end
end

local function setPlayerJumpPower(value)
    local humanoid = getHumanoid()
    if humanoid then
        humanoid.JumpPower = value
    end
end

local function getPlayerNames()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        table.insert(list, player.Name)
    end
    table.sort(list)
    return list
end

