        end
        if choice == "spawn" then
            local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation")
            if spawn then
                getCharacter():PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
            end
        elseif choice == "saved" then
            if savedPosition then
                getCharacter():PivotTo(savedPosition)
            end
        elseif choice == "above" then
            getCharacter():PivotTo(root.CFrame + Vector3.new(0, 25, 0))
        end
    end,
})

