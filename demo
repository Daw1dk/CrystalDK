UIS.InputBegan:Connect(function(input, gpe)
    if gpe or input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end
    if notifyKeybind and notifyKeybind.Get and input.KeyCode == notifyKeybind:Get() then
        notify("Hotkey", tostring(input.KeyCode), 1.4)
        setStatus(runtimeStatus, "Hotkey", 88)
    end
end)

