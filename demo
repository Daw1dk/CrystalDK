regionLabel = RulesTab:CreateLabel({
    Id = "region_distance",
    Title = "Region Distance",
    Subtitle = "Used by RequireRegion demo",
    Value = "No anchor",
    Rules = {
        RequireUpdate = function(state, obj)
            state._regionTick = state._regionTick or 0
            if os.clock() - state._regionTick >= 0.3 then
                state._regionTick = os.clock()
                local root = getRoot()
                if not demoRegionCenter or not root then
                    obj:Set("No anchor")
                else
                    obj:Set(tostring(round((root.Position - demoRegionCenter).Magnitude)) .. " studs")
                end
            end
        end,
    },
})

RulesTab:CreateButton({
