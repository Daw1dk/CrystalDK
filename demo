local function round(n)
    return math.floor((tonumber(n) or 0) + 0.5)
end

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoid()
    local character = getCharacter()
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function readPingMs()
    local ok, result = pcall(function()
        local item = Stats.Network.ServerStatsItem["Data Ping"]
        if item and item.GetValue then
            return tonumber(item:GetValue())
        end
        if item and item.GetValueString then
            local valueString = tostring(item:GetValueString())
            local ms = valueString:match("([%d%.]+)")
            return tonumber(ms)
        end
        return nil
    end)
    if ok then
        return result
    end
    return nil
end

local function notify(title, subtitle, duration)
    if Window then
        Window:SendNotification({
            Title = title,
            Subtitle = subtitle,
            Duration = duration or 2,
        })
    end
end

local function setCardValue(card, value)
    if card and type(card.Set) == "function" then
        card:Set(value)
    elseif card and type(card.SetValue) == "function" then
        card:SetValue(value)
    end
end

local function setStatus(card, status, percent)
    if card and type(card.SetStatus) == "function" then
        card:SetStatus(status, percent)
    elseif card and type(card.Set) == "function" then
        card:Set(status, percent)
    end
end

local function updateRuntimeTable()
    if not runtimeTable or not Window then
        return
    end

    local root = getRoot()
    local ping = readPingMs()
    local distance = demoRegionCenter and root and round((root.Position - demoRegionCenter).Magnitude) or "No anchor"

    runtimeTable:SetRows({
        {Name = "Permission", Value = tostring(getWindowPermission())},
        {Name = "Suffix", Value = tostring(getWindowSuffix() or "none")},
        {Name = "Ping", Value = ping and (tostring(round(ping)) .. " ms") or "n/a"},
        {Name = "Region Dist", Value = tostring(distance)},
    })
end

local function syncOverview(value, labelText)
    local nextValue = math.clamp(tonumber(value) or 0, 0, 100)
    setCardValue(demoProgress, nextValue)
    setCardValue(demoCircle, nextValue)
    setStatus(runtimeStatus, labelText or "Running", nextValue)
    table.insert(graphPoints, nextValue)
    while #graphPoints > 12 do
        table.remove(graphPoints, 1)
    end
    if runtimeGraph then
        runtimeGraph:SetPoints(graphPoints)
    end
    updateRuntimeTable()
end

local function averageValues(values)
    local total = 0
    local count = 0
    for _, value in ipairs(values or {}) do
        total += tonumber(value) or 0
        count += 1
    end
    return count > 0 and (total / count) or 0
end

getWindowPermission = function()
