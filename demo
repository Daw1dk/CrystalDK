DataTab:CreateDivider({ Label = "Telemetry Graphs" })

DataTab:CreateLineGraph({
    Id        = "demo_data_graph_wave",
    Title     = "Sine Wave",
    Subtitle  = "slow synthetic wave driven by RequireUpdate",
    Points    = { 55, 63, 71, 77, 72, 65, 57 },
    RuleGroup = "accent_blue",
    Rules = {
        RequireUpdate = function(state, obj)
            state._tick   = state._tick   or 0
            state._phase  = state._phase  or 0
            state._points = state._points or { 55, 63, 71, 77, 72, 65, 57 }
            if os.clock() - state._tick >= 1.1 then
                state._tick  = os.clock()
                state._phase = state._phase + 0.45
                table.insert(state._points, math.floor((math.sin(state._phase) * 22) + 55))
                while #state._points > 16 do table.remove(state._points, 1) end
                obj:SetPoints(state._points)
            end
        end,
    },
})

